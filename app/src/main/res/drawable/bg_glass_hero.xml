<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="@color/hero_tint_top"
                android:endColor="@color/hero_tint_bottom" />
            <corners android:radius="28dp" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_stroke" />
        </shape>
    </item>
    <item android:top="1dp" android:right="1dp" android:left="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_glass" />
            <corners
                android:topLeftRadius="27dp"
                android:topRightRadius="27dp"
                android:bottomLeftRadius="28dp"
                android:bottomRightRadius="28dp" />
        </shape>
    </item>
    <item android:top="1dp" android:left="1dp" android:right="1dp" android:bottom="55dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#14FFFFFF"
                android:endColor="#05FFFFFF" />
            <corners
                android:topLeftRadius="27dp"
                android:topRightRadius="27dp"
                android:bottomLeftRadius="28dp"
                android:bottomRightRadius="28dp" />
        </shape>
    </item>
</layer-list>
